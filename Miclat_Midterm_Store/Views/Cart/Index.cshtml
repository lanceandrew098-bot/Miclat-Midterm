@model IEnumerable<Miclat_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Shopping Cart</h1>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.ProductName
                            </td>

                            <td>
                                ₱@item.Price.ToString("N2")
                            </td>

                            <td>
                                <form asp-action="UpdateQuantity"
                                      method="post"
                                      class="d-flex">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control"
                                           style="width:100px;" />

                                    <button type="submit"
                                            class="btn btn-warning ms-2">
                                        Update
                                    </button>

                                </form>
                            </td>

                            <td>
                                ₱@((item.Price * item.Quantity).ToString("N2"))
                            </td>

                            <td>
                                <form asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Remove
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="text-end mt-4">

            <h3>
                Total:
                ₱@total.ToString("N2")
            </h3>

        </div>
    }

</div>